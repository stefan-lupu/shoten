# Șablon pentru .env.local — copiază-l pentru fiecare magazin clonat
# și completează valorile specifice brandului. Nimic din acest fișier
# nu trebuie să apară hardcodat în cod sau template-uri.

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://user:password@127.0.0.1:3306/dbname?serverVersion=8.0.46&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> store identity ###
# Numele magazinului, afișat în header, title, footer.
STORE_NAME=""
# Sloganul afișat sub nume în header/hero.
STORE_SLOGAN=""
# Domeniul de producție (fără protocol), folosit la generarea URL-urilor absolute (sitemap, meta og:url).
STORE_DOMAIN=""
# Meta description implicită pentru paginile fără una specifică.
STORE_DEFAULT_META_DESCRIPTION=""
STORE_EMAIL=""
STORE_PHONE=""
###< store identity ###

###> store theme ###
# Culori temă, folosite ca variabile CSS (--color-bg, --color-surface, etc.) în base.html.twig.
THEME_COLOR_BG=""
THEME_COLOR_SURFACE=""
THEME_COLOR_TEXT=""
THEME_COLOR_TEXT_MUTED=""
THEME_COLOR_ACCENT=""
THEME_COLOR_ACCENT_STRONG=""
# Cale publică către logo (ex: /images/logo.svg). Gol = se afișează numele ca text.
THEME_LOGO_PATH=""
THEME_FAVICON_PATH="/favicon.ico"
###< store theme ###

###> store integrations ###
# Toate opționale — lăsate goale, funcționalitatea aferentă e dezactivată automat.
GOOGLE_ADSENSE_CLIENT_ID=""
GOOGLE_ADS_CONVERSION_ID=""
GOOGLE_ANALYTICS_ID=""
NETOPIA_API_KEY=""
NETOPIA_SIGNATURE=""
###< store integrations ###
