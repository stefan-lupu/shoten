{% if store.adsenseClientId and app.request.cookies.get('cookie_consent') == 'accepted' %}
    <ins class="adsbygoogle d-block my-3"
         style="text-align:center"
         data-ad-client="{{ store.adsenseClientId }}"
         data-ad-slot="{{ slotId }}"
         data-ad-format="auto"
         data-full-width-responsive="true"></ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
{% endif %}
