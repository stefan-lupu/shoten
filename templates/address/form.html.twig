{% extends 'base.html.twig' %}

{% block title %}{{ isNew ? 'Adresă nouă' : 'Editează adresa' }} — {{ store.name }}{% endblock %}

{% block body %}
    <h1 class="mb-4">{{ isNew ? 'Adresă nouă' : 'Editează adresa' }}</h1>

    <div class="col-md-7">
        {{ form_start(form) }}
            {{ form_row(form.fullName) }}
            {{ form_row(form.phone) }}
            {{ form_row(form.county) }}
            {{ form_row(form.city) }}
            {{ form_row(form.street) }}
            {{ form_row(form.postalCode) }}

            <button type="submit" class="btn btn-primary mt-3">Salvează</button>
            <a href="{{ path('app_address_index') }}" class="btn btn-outline-secondary mt-3">Anulează</a>
        {{ form_end(form) }}
    </div>
{% endblock %}
