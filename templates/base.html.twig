<!DOCTYPE html>
<html lang="ro" data-bs-theme="{{ store.themeMode }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="{% block meta_description %}{{ store.defaultMetaDescription }}{% endblock %}">
        <title>{% block title %}{{ store.name }}{% endblock %}</title>
        {% if store.faviconPath %}
            <link rel="icon" href="{{ store.faviconPath }}">
        {% endif %}

        {% block canonical %}
            <link rel="canonical" href="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">
        {% endblock %}

        {% block open_graph %}
            <meta property="og:type" content="website">
            <meta property="og:site_name" content="{{ store.name }}">
            <meta property="og:title" content="{{ block('title') }}">
            <meta property="og:description" content="{{ block('meta_description') }}">
            <meta property="og:url" content="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">
            {% if store.logoPath %}
                <meta property="og:image" content="{{ absolute_url(store.logoPath) }}">
            {% endif %}
        {% endblock %}

        <style>
            :root {
                --color-bg: {{ store.themeColors.bg }};
                --color-bg-rgb: {{ store.themeColors.bg|hex2rgb }};
                --color-surface: {{ store.themeColors.surface }};
                --color-text: {{ store.themeColors.text }};
                --color-text-muted: {{ store.themeColors.textMuted }};
                --color-accent: {{ store.themeColors.accent }};
                --color-accent-rgb: {{ store.themeColors.accent|hex2rgb }};
                --color-accent-strong: {{ store.themeColors.accentStrong }};
                --color-accent-strong-rgb: {{ store.themeColors.accentStrong|hex2rgb }};
            }
        </style>

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {# Scripturile Google (Analytics/Ads/AdSense) încarcă doar cu consimțământ explicit — vezi _cookie_consent_banner.html.twig. #}
        {% set cookieConsentAccepted = app.request.cookies.get('cookie_consent') == 'accepted' %}
        {% if cookieConsentAccepted and (store.googleAnalyticsId or store.googleAdsConversionId) %}
            <script async src="https://www.googletagmanager.com/gtag/js?id={{ store.googleAnalyticsId ?: store.googleAdsConversionId }}"></script>
            <script>
                window.dataLayer = window.dataLayer || [];
                function gtag(){dataLayer.push(arguments);}
                gtag('js', new Date());
                {% if store.googleAnalyticsId %}gtag('config', '{{ store.googleAnalyticsId }}');{% endif %}
                {% if store.googleAdsConversionId %}gtag('config', '{{ store.googleAdsConversionId }}');{% endif %}
            </script>
        {% endif %}
        {% if cookieConsentAccepted and store.adsenseClientId %}
            <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ store.adsenseClientId }}" crossorigin="anonymous"></script>
        {% endif %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        <header class="navbar navbar-expand-md">
            <div class="container flex-wrap">
                <a href="{{ path('app_home') }}" class="navbar-brand d-flex flex-column lh-1">
                    {% if store.logoPath %}
                        <img src="{{ store.logoPath }}" alt="{{ store.name }}" height="32">
                    {% else %}
                        <span class="logo-text fs-4">{{ store.name }}</span>
                    {% endif %}
                    {% if store.slogan %}
                        <small class="text-body-secondary">{{ store.slogan }}</small>
                    {% endif %}
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav" aria-controls="main-nav" aria-expanded="false" aria-label="Comută navigarea">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="main-nav">
                    <ul class="navbar-nav me-auto">
                        {% import 'product/_category_menu_items.html.twig' as categoryMenu %}
                        {% for category in category_repository.findRootCategories %}
                            {% if category.children is empty %}
                                <li class="nav-item">
                                    <a href="{{ path('app_category_show', { slug: category.slug }) }}" class="nav-link">{{ category.name }}</a>
                                </li>
                            {% else %}
                                <li class="nav-item dropdown">
                                    <a href="{{ path('app_category_show', { slug: category.slug }) }}" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">{{ category.name }}</a>
                                    <ul class="dropdown-menu">
                                        {{ categoryMenu.items(category.children, 0) }}
                                    </ul>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>

                    <form method="get" action="{{ path('app_product_search') }}" class="d-flex mx-md-3 my-2 my-md-0" role="search">
                        <input type="search" name="q" value="{{ app.request.query.get('q') }}" class="form-control form-control-sm" placeholder="Caută produse..." aria-label="Caută produse">
                    </form>

                    <div class="d-flex align-items-center gap-3">
                        <a href="{{ path('app_cart') }}" class="btn btn-outline-primary btn-sm">Coș ({{ cart_manager.itemCount }})</a>
                        {% if is_granted('ROLE_USER') %}
                            <a href="{{ path('app_account') }}" class="nav-link d-inline">Cont</a>
                            <a href="{{ path('app_logout') }}" class="nav-link d-inline">Deconectare</a>
                        {% else %}
                            <a href="{{ path('app_login') }}" class="nav-link d-inline">Autentificare</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </header>

        <main class="container py-4">
            {% if app.user and not app.user.verified %}
                <div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span>Adresa ta de email nu este confirmată încă. Verifică-ți inbox-ul pentru linkul de confirmare.</span>
                    <form method="post" action="{{ path('app_verify_email_resend') }}" class="mb-0">
                        <input type="hidden" name="_token" value="{{ csrf_token('verify_email_resend') }}">
                        <button type="submit" class="btn btn-sm btn-outline-dark">Retrimite emailul</button>
                    </form>
                </div>
            {% endif %}

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <span class="d-none" data-flash="{{ label == 'error' ? 'error' : 'success' }}">{{ message }}</span>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="container py-4 mt-4 border-top text-body-secondary">
            <div class="row">
                <div class="col-md-6">
                    <p class="mb-1">{{ store.name }}</p>
                    {% if store.companyName %}<p class="mb-1 small">{{ store.companyName }}{% if store.companyCui %}, CUI {{ store.companyCui }}{% endif %}{% if store.companyRegCom %}, Nr. Reg. Com. {{ store.companyRegCom }}{% endif %}</p>{% endif %}
                    {% if store.companyAddress %}<p class="mb-1 small">{{ store.companyAddress }}</p>{% endif %}
                    {% if store.email %}<p class="mb-1"><a href="mailto:{{ store.email }}">{{ store.email }}</a></p>{% endif %}
                    {% if store.phone %}<p class="mb-0">{{ store.phone }}</p>{% endif %}

                    <ul class="list-inline small mt-3 mb-0">
                        <li class="list-inline-item"><a href="{{ path('app_terms') }}">Termeni și condiții</a></li>
                        <li class="list-inline-item">·</li>
                        <li class="list-inline-item"><a href="{{ path('app_return_policy') }}">Politica de retur</a></li>
                        <li class="list-inline-item">·</li>
                        <li class="list-inline-item"><a href="{{ path('app_privacy_policy') }}">Confidențialitate</a></li>
                    </ul>
                    <p class="small mt-2 mb-0">
                        Litigii nesoluționate amiabil:
                        <a href="https://anpc.ro" target="_blank" rel="noopener">ANPC</a>
                        ·
                        <a href="https://ec.europa.eu/consumers/odr" target="_blank" rel="noopener">SOL</a>
                    </p>
                </div>
                <div class="col-md-6">
                    {{ render(controller('App\\Controller\\NewsletterController::widget')) }}
                </div>
            </div>
            {% if app.request.attributes.get('_route') not in ['app_checkout', 'app_payment_simulate'] %}
                <div class="row mt-3">
                    <div class="col-12">
                        {% include '_adsense_slot.html.twig' with { slotId: '1234567890' } %}
                    </div>
                </div>
            {% endif %}
        </footer>

        {% include '_cookie_consent_banner.html.twig' %}
    </body>
</html>
