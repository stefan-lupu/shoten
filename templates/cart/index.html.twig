{% extends 'base.html.twig' %}

{% block title %}Coșul meu — {{ store.name }}{% endblock %}

{% block body %}
    <h1 class="mb-4">Coșul meu</h1>

    {% if cart.items is empty %}
        <p>Coșul este gol. <a href="{{ path('app_home') }}">Vezi produsele</a>.</p>
    {% else %}
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Produs</th>
                        <th>Preț unitar</th>
                        <th>Cantitate</th>
                        <th>Subtotal</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in cart.items %}
                        <tr>
                            <td>
                                <a href="{{ path('app_product_show', { slug: item.product.slug }) }}">{{ item.product.name }}</a>
                            </td>
                            <td>{{ item.unitPrice }} lei</td>
                            <td>
                                <form method="post" action="{{ path('app_cart_update', { item: item.id }) }}" class="d-flex gap-2">
                                    <input type="number" name="quantity" value="{{ item.quantity }}" min="1" {% if item.product.stockStatus.value == 'in_stock' %}max="{{ item.product.stock }}"{% endif %} class="form-control form-control-sm" style="width: 5rem">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cart_action') }}">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Actualizează</button>
                                </form>
                            </td>
                            <td>{{ item.subtotal }} lei</td>
                            <td>
                                <form method="post" action="{{ path('app_cart_remove', { item: item.id }) }}" data-confirm="Sigur elimini acest produs din coș?">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cart_action') }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Elimină</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <p class="fs-5">Total: <strong>{{ total }} lei</strong></p>

        {% if is_granted('ROLE_USER') %}
            <a href="{{ path('app_checkout') }}" class="btn btn-primary">Finalizează comanda</a>
        {% else %}
            <p><a href="{{ path('app_login') }}">Autentifică-te</a> pentru a finaliza comanda.</p>
        {% endif %}
    {% endif %}
{% endblock %}
