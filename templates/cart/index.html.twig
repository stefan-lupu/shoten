{% extends 'base.html.twig' %}

{% block title %}Coșul meu — {{ store.name }}{% endblock %}

{% block body %}
    <h1 class="mb-4">Coșul meu</h1>

    {% if cart.items is empty %}
        <div class="cart-empty text-center py-5">
            <div class="cart-empty__icon mb-3">🛒</div>
            <h2 class="h4">Coșul tău e gol</h2>
            <p class="text-body-secondary mb-4">Descoperă papetăria noastră japoneză și adaugă primele produse.</p>
            <a href="{{ path('app_home') }}" class="btn btn-primary">Vezi produsele</a>
        </div>
    {% else %}
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="cart-lines">
                    {% for item in cart.items %}
                        <div class="cart-line">
                            <a href="{{ path('app_product_show', { slug: item.product.slug }) }}" class="cart-line__media">
                                {% if item.product.images is not empty %}
                                    <img src="{{ asset('images/products/' ~ item.product.images.first.filename) }}" alt="{{ item.product.name }}">
                                {% else %}
                                    <span class="cart-line__noimg">Fără imagine</span>
                                {% endif %}
                            </a>
                            <div class="cart-line__info">
                                <a href="{{ path('app_product_show', { slug: item.product.slug }) }}" class="cart-line__name">{{ item.product.name }}</a>
                                <p class="cart-line__meta">{{ item.unitPrice }} lei / buc · Origine: {{ item.product.origin }}</p>
                                <form method="post" action="{{ path('app_cart_update', { item: item.id }) }}" class="cart-line__qty">
                                    <label class="visually-hidden" for="qty-{{ item.id }}">Cantitate</label>
                                    <input type="number" id="qty-{{ item.id }}" name="quantity" value="{{ item.quantity }}" min="1" {% if item.product.stockStatus.value == 'in_stock' %}max="{{ item.product.stock }}"{% endif %} class="form-control form-control-sm">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cart_action') }}">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Actualizează</button>
                                </form>
                            </div>
                            <div class="cart-line__end">
                                <span class="cart-line__subtotal">{{ item.subtotal }} lei</span>
                                <form method="post" action="{{ path('app_cart_remove', { item: item.id }) }}" data-confirm="Sigur elimini acest produs din coș?">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cart_action') }}">
                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0" aria-label="Elimină {{ item.product.name }}">Elimină</button>
                                </form>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <div class="card mt-3">
                    <div class="card-body">
                        <h2 class="h6 card-title mb-3">Cod promoțional</h2>
                        <form method="post" action="{{ path('app_cart_apply_coupon') }}" class="d-flex flex-wrap gap-2">
                            <input type="text" name="coupon_code" value="{{ appliedCouponCode }}" placeholder="Ex: PRIMAVARA20" class="form-control" style="max-width: 16rem">
                            <input type="hidden" name="_token" value="{{ csrf_token('cart_action') }}">
                            <button type="submit" class="btn btn-outline-primary">Aplică</button>
                            {% if appliedCouponCode %}
                                <button type="submit" formaction="{{ path('app_cart_remove_coupon') }}" class="btn btn-outline-secondary">Elimină codul</button>
                            {% endif %}
                        </form>
                        {% if campaignResult.couponError %}
                            <div class="alert alert-danger mt-2 mb-0">{{ campaignResult.couponError }}</div>
                        {% endif %}
                    </div>
                </div>

                <a href="{{ path('app_home') }}" class="d-inline-block mt-3 small">← Continuă cumpărăturile</a>
            </div>

            <div class="col-lg-4">
                <div class="card order-summary">
                    <div class="card-body">
                        <h2 class="h5 card-title mb-3">Sumar comandă</h2>

                        {% if campaignResult.discounts is not empty %}
                            <div class="alert alert-success py-2 px-3 small mb-3">
                                <strong>Reduceri aplicate:</strong>
                                <ul class="mb-0 ps-3">
                                    {% for discount in campaignResult.discounts %}
                                        <li>{{ discount.description }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}

                        <dl class="summary-lines mb-0">
                            <div class="summary-row">
                                <dt>Subtotal</dt>
                                <dd>{{ campaignResult.subtotal }} lei</dd>
                            </div>
                            {% if campaignResult.discounts is not empty %}
                                <div class="summary-row text-success">
                                    <dt>Reducere</dt>
                                    <dd>−{{ campaignResult.getTotalDiscount }} lei</dd>
                                </div>
                            {% endif %}
                            <div class="summary-row">
                                <dt>Transport</dt>
                                <dd>
                                    {% if campaignResult.shippingCost == '0.00' %}
                                        <span class="text-success">Gratuit</span>
                                    {% else %}
                                        {{ campaignResult.shippingCost }} lei
                                    {% endif %}
                                </dd>
                            </div>
                            <div class="summary-row summary-row--total">
                                <dt>Total</dt>
                                <dd>{{ campaignResult.total }} lei</dd>
                            </div>
                        </dl>

                        {% if wholesaleMinimumWarning %}
                            <div class="alert alert-warning mt-3 mb-0 py-2 px-3 small">{{ wholesaleMinimumWarning }}</div>
                        {% endif %}

                        <a href="{{ path('app_checkout') }}" class="btn btn-primary w-100 mt-3 {{ wholesaleMinimumWarning ? 'disabled' : '' }}">Finalizează comanda</a>

                        {% if not is_granted('ROLE_USER') %}
                            <p class="small text-body-secondary mt-2 mb-0">
                                Poți comanda și fără cont. <a href="{{ path('app_login') }}">Autentifică-te</a>
                                pentru plata cu cardul și adrese salvate.
                            </p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
