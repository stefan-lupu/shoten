{% extends 'base.html.twig' %}

{% block title %}Coșul meu — {{ store.name }}{% endblock %}

{% block body %}
    <h1>Coșul meu</h1>

    {% if cart.items is empty %}
        <p>Coșul este gol. <a href="{{ path('app_home') }}">Vezi produsele</a>.</p>
    {% else %}
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Produs</th>
                    <th>Preț unitar</th>
                    <th>Cantitate</th>
                    <th>Subtotal</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for item in cart.items %}
                    <tr>
                        <td>
                            <a href="{{ path('app_product_show', { slug: item.product.slug }) }}">{{ item.product.name }}</a>
                        </td>
                        <td>{{ item.unitPrice }} lei</td>
                        <td>
                            <form method="post" action="{{ path('app_cart_update', { item: item.id }) }}">
                                <input type="number" name="quantity" value="{{ item.quantity }}" min="1" {% if item.product.stockStatus.value == 'in_stock' %}max="{{ item.product.stock }}"{% endif %}>
                                <input type="hidden" name="_token" value="{{ csrf_token('cart_action') }}">
                                <button type="submit" class="btn btn--small">Actualizează</button>
                            </form>
                        </td>
                        <td>{{ item.subtotal }} lei</td>
                        <td>
                            <form method="post" action="{{ path('app_cart_remove', { item: item.id }) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart_action') }}">
                                <button type="submit" class="btn btn--small btn--danger">Elimină</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <p class="cart-total">Total: <strong>{{ total }} lei</strong></p>
    {% endif %}
{% endblock %}
