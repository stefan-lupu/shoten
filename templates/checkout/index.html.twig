{% extends 'base.html.twig' %}

{% block title %}Finalizare comandă — {{ store.name }}{% endblock %}

{% block body %}
    <h1 class="mb-4">Finalizare comandă</h1>

    <div class="row g-4">
        <div class="col-md-7">
            {{ form_start(form) }}
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="h4 mb-0">Adresă de livrare</h2>
                    <a href="{{ path('app_address_new', { redirect_to: 'checkout' }) }}" class="small">+ Adaugă o adresă nouă</a>
                </div>
                {{ form_row(form.address) }}

                <h2 class="h4 mt-4">Metodă de plată</h2>
                {{ form_row(form.paymentMethod) }}

                <button type="submit" class="btn btn-primary mt-3">Plasează comanda</button>
            {{ form_end(form) }}
        </div>

        <div class="col-md-5">
            <div class="card">
                <div class="card-body">
                    <h2 class="h4 card-title">Sumar comandă</h2>
                    <ul class="list-group list-group-flush mb-3">
                        {% for item in cart.items %}
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <span>{{ item.product.name }} × {{ item.quantity }}</span>
                                <span>{{ item.subtotal }} lei</span>
                            </li>
                        {% endfor %}
                    </ul>

                    {% if campaignResult.discounts is not empty %}
                        <ul class="list-group list-group-flush mb-3">
                            {% for discount in campaignResult.discounts %}
                                <li class="list-group-item px-0 text-success small">{{ discount.description }}</li>
                            {% endfor %}
                        </ul>
                        <p class="mb-1">Subtotal: {{ campaignResult.subtotal }} lei</p>
                    {% endif %}

                    <p class="fs-5 mb-0">Total: <strong>{{ campaignResult.total }} lei</strong></p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
