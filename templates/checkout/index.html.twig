{% extends 'base.html.twig' %}

{% block title %}Finalizare comandă — {{ store.name }}{% endblock %}

{% block body %}
    <h1 class="mb-4">Finalizare comandă</h1>

    <div class="row g-4">
        <div class="col-lg-7">
            {{ form_start(form) }}
                {% if isGuest %}
                    <div class="checkout-section">
                        <h2 class="h5 checkout-section__title"><span class="checkout-step">1</span> Datele tale</h2>
                        {{ form_row(form.guestEmail) }}
                    </div>

                    <div class="checkout-section">
                        <h2 class="h5 checkout-section__title"><span class="checkout-step">2</span> Adresă de livrare</h2>
                        {{ form_row(form.fullName) }}
                        {{ form_row(form.phone) }}
                        <div class="row">
                            <div class="col-sm-6">{{ form_row(form.county) }}</div>
                            <div class="col-sm-6">{{ form_row(form.city) }}</div>
                        </div>
                        {{ form_row(form.street) }}
                        {{ form_row(form.postalCode) }}
                        <p class="small text-body-secondary mb-0">
                            Ai deja cont? <a href="{{ path('app_login') }}">Autentifică-te</a> ca să folosești
                            adresele salvate și plata cu cardul.
                        </p>
                    </div>
                {% else %}
                    <div class="checkout-section">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h2 class="h5 checkout-section__title mb-0"><span class="checkout-step">1</span> Adresă de livrare</h2>
                            <a href="{{ path('app_address_new', { redirect_to: 'checkout' }) }}" class="small text-nowrap">+ Adresă nouă</a>
                        </div>
                        {{ form_row(form.address) }}
                    </div>
                {% endif %}

                <div class="checkout-section">
                    <h2 class="h5 checkout-section__title"><span class="checkout-step">{{ isGuest ? '3' : '2' }}</span> Metodă de plată</h2>
                    {{ form_row(form.paymentMethod) }}
                </div>

                <button type="submit" class="btn btn-primary btn-lg mt-2">Plasează comanda</button>
            {{ form_end(form) }}
        </div>

        <div class="col-lg-5">
            <div class="card order-summary">
                <div class="card-body">
                    <h2 class="h5 card-title mb-3">Sumar comandă</h2>

                    <ul class="checkout-items list-unstyled mb-3">
                        {% for item in cart.items %}
                            <li class="checkout-item">
                                <span class="checkout-item__media">
                                    {% if item.product.images is not empty %}
                                        <img src="{{ asset('images/products/' ~ item.product.images.first.filename) }}" alt="{{ item.product.name }}">
                                    {% else %}
                                        <span class="checkout-item__noimg"></span>
                                    {% endif %}
                                    <span class="checkout-item__qty">{{ item.quantity }}</span>
                                </span>
                                <span class="checkout-item__name">{{ item.product.name }}</span>
                                <span class="checkout-item__price">{{ item.subtotal }} lei</span>
                            </li>
                        {% endfor %}
                    </ul>

                    {% if campaignResult.discounts is not empty %}
                        <ul class="list-unstyled small text-success mb-3">
                            {% for discount in campaignResult.discounts %}
                                <li>✓ {{ discount.description }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                    <dl class="summary-lines mb-0">
                        <div class="summary-row">
                            <dt>Subtotal</dt>
                            <dd>{{ campaignResult.subtotal }} lei</dd>
                        </div>
                        <div class="summary-row">
                            <dt>Transport</dt>
                            <dd>
                                {% if campaignResult.shippingCost == '0.00' %}
                                    <span class="text-success">Gratuit</span>
                                {% else %}
                                    {{ campaignResult.shippingCost }} lei
                                {% endif %}
                            </dd>
                        </div>
                        <div class="summary-row summary-row--total">
                            <dt>Total</dt>
                            <dd>{{ campaignResult.total }} lei</dd>
                        </div>
                    </dl>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
