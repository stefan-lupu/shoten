{% extends 'base.html.twig' %}

{% block title %}Comanda #{{ order.id }} — {{ store.name }}{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if fireAdsConversion %}
        {# gtag() e deja definit în base.html.twig (aceleași condiții: consimțământ + ID Ads setat).
           Doar valoarea comenzii și un ID de tranzacție anonim (id-ul comenzii) — fără nume/email, conform politicilor Google Ads. #}
        <script>
            gtag('event', 'conversion', {
                'send_to': {{ store.googleAdsConversionId|json_encode|raw }},
                'value': {{ order.total|json_encode|raw }},
                'currency': 'RON',
                'transaction_id': {{ ('order-' ~ order.id)|json_encode|raw }}
            });
        </script>
    {% endif %}
{% endblock %}

{% block body %}
    <h1 class="mb-3">Comanda #{{ order.id }}</h1>
    <p>Status: {% include 'order/_status_badge.html.twig' with { status: order.status } %}</p>
    <p>Plată: {{ order.paymentMethod.value }} ({{ order.paymentStatus.value }})</p>
    <p>Livrare la: {{ order.shippingFullName }}, {{ order.shippingStreet }}, {{ order.shippingCity }}, {{ order.shippingCounty }}, {{ order.shippingPostalCode }}, tel. {{ order.shippingPhone }}</p>
    {% if order.trackingNumber %}
        <p>Număr AWB: <strong>{{ order.trackingNumber }}</strong></p>
    {% endif %}
    {% if order.refundedAt %}
        <p class="text-warning">Rambursată la {{ order.refundedAt|date('d.m.Y H:i') }}.</p>
    {% endif %}

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Produs</th>
                    <th>Cantitate</th>
                    <th>Preț unitar</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                {% for item in order.items %}
                    <tr>
                        <td>{{ item.productName }}</td>
                        <td>{{ item.quantity }}</td>
                        <td>{{ item.unitPrice }} lei</td>
                        <td>{{ item.subtotal }} lei</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <p class="mb-1">
        Transport:
        {% if order.shippingCost == '0.00' %}
            <span class="text-success">Gratuit</span>
        {% else %}
            {{ order.shippingCost }} lei
        {% endif %}
    </p>
    <p class="fs-5">Total: <strong>{{ order.total }} lei</strong></p>

    <a href="{{ path('app_order_invoice', { id: order.id }) }}" class="btn btn-outline-secondary" target="_blank">Descarcă factura (PDF)</a>

    {% if order.paymentMethod.value == 'bank_transfer' and order.paymentStatus.value != 'paid' %}
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h5 card-title">Detalii transfer bancar</h2>
                <p class="mb-1">Titular: {{ store.name }}</p>
                <p class="mb-1">Bancă: {{ store.bankName }}</p>
                <p class="mb-1">IBAN: {{ store.bankAccount }}</p>
                <p class="mb-0">Menționează în detaliile transferului numărul comenzii: <strong>#{{ order.id }}</strong></p>
            </div>
        </div>
    {% endif %}

    {% if order.paymentMethod.value == 'card' and order.paymentStatus.value != 'paid' %}
        <form method="post" action="{{ path('app_order_retry_payment', { id: order.id }) }}" class="d-inline">
            <input type="hidden" name="_token" value="{{ csrf_token('order_retry_payment_' ~ order.id) }}">
            <button type="submit" class="btn btn-primary">Reîncearcă plata</button>
        </form>
    {% endif %}

    {% if order.status.value == 'pending' %}
        <form method="post" action="{{ path('app_order_cancel', { id: order.id }) }}" class="d-inline" data-confirm="Sigur anulezi această comandă?">
            <input type="hidden" name="_token" value="{{ csrf_token('order_cancel_' ~ order.id) }}">
            <button type="submit" class="btn btn-outline-danger">Anulează comanda</button>
        </form>
    {% endif %}
{% endblock %}
