{% extends 'base.html.twig' %}

{% block title %}Comanda #{{ order.id }} — {{ store.name }}{% endblock %}

{% block body %}
    <h1>Comanda #{{ order.id }}</h1>
    <p>Status: {{ order.status.value }}</p>
    <p>Plată: {{ order.paymentMethod.value }} ({{ order.paymentStatus.value }})</p>
    <p>Livrare la: {{ order.shippingFullName }}, {{ order.shippingStreet }}, {{ order.shippingCity }}, {{ order.shippingCounty }}, {{ order.shippingPostalCode }}, tel. {{ order.shippingPhone }}</p>

    <table class="order-items-table">
        <thead>
            <tr>
                <th>Produs</th>
                <th>Cantitate</th>
                <th>Preț unitar</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            {% for item in order.items %}
                <tr>
                    <td>{{ item.productName }}</td>
                    <td>{{ item.quantity }}</td>
                    <td>{{ item.unitPrice }} lei</td>
                    <td>{{ item.subtotal }} lei</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <p class="order-total">Total: <strong>{{ order.total }} lei</strong></p>

    {% if order.paymentMethod.value == 'bank_transfer' and order.paymentStatus.value != 'paid' %}
        <div class="bank-transfer-details">
            <h2>Detalii transfer bancar</h2>
            <p>Titular: {{ store.name }}</p>
            <p>Bancă: {{ store.bankName }}</p>
            <p>IBAN: {{ store.bankAccount }}</p>
            <p>Menționează în detaliile transferului numărul comenzii: <strong>#{{ order.id }}</strong></p>
        </div>
    {% endif %}

    {% if order.paymentMethod.value == 'card' and order.paymentStatus.value != 'paid' %}
        <form method="post" action="{{ path('app_order_retry_payment', { id: order.id }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('order_retry_payment_' ~ order.id) }}">
            <button type="submit" class="btn">Reîncearcă plata</button>
        </form>
    {% endif %}
{% endblock %}
