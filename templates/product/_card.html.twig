<div class="col">
    <div class="card h-100">
        <a href="{{ path('app_product_show', { slug: product.slug }) }}" class="text-decoration-none text-body">
            {% if product.images is not empty %}
                <img src="{{ asset('images/products/' ~ product.images.first.filename) }}" alt="{{ product.name }}" class="card-img-top" style="aspect-ratio: 1; object-fit: cover">
            {% else %}
                <div class="card-img-top bg-body-tertiary d-flex align-items-center justify-content-center text-body-secondary" style="aspect-ratio: 1">Fără imagine</div>
            {% endif %}
            <div class="card-body pb-0">
                <h3 class="card-title h5">{{ product.name }}</h3>
                <p class="card-text fw-bold mb-1">{{ product.price }} lei</p>
                <p class="card-text text-body-secondary mb-2">Origine: {{ product.origin }}</p>
                {% include 'product/_stock_badge.html.twig' %}
            </div>
        </a>
        <div class="card-body pt-2">
            <form method="post" action="{{ path('app_cart_add', { product: product.id }) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('cart_action') }}">
                <button type="submit" class="btn btn-primary btn-sm w-100" {% if product.stockStatus.value != 'in_stock' or product.stock <= 0 %}disabled{% endif %}>Adaugă în coș</button>
            </form>
        </div>
    </div>
</div>
