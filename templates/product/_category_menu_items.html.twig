{# Randează recursiv o listă de categorii (și subcategoriile lor, la orice adâncime) ca itemi de dropdown Bootstrap, indentați. #}
{% macro items(categories, depth) %}
    {% import _self as self %}
    {% for category in categories %}
        <li>
            <a href="{{ path('app_category_show', { slug: category.slug }) }}" class="dropdown-item" style="padding-left: {{ 1 + depth }}rem">
                {{ category.name }}
            </a>
        </li>
        {% if category.children is not empty %}
            {{ self.items(category.children, depth + 1) }}
        {% endif %}
    {% endfor %}
{% endmacro %}
