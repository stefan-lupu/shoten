{# Așteaptă: formAction, sort, minPrice, maxPrice — opțional: query (pentru pagina de căutare). #}
<form method="get" action="{{ formAction }}" class="row g-2 align-items-end mb-4">
    {% if query is defined %}
        <input type="hidden" name="q" value="{{ query }}">
    {% endif %}
    <div class="col-auto">
        <label for="sort" class="form-label small mb-0">Sortează după</label>
        <select name="sort" id="sort" class="form-select form-select-sm" onchange="this.form.requestSubmit()">
            <option value="name" {{ sort is null or sort == 'name' ? 'selected' }}>Nume (A-Z)</option>
            <option value="price_asc" {{ sort == 'price_asc' ? 'selected' }}>Preț crescător</option>
            <option value="price_desc" {{ sort == 'price_desc' ? 'selected' }}>Preț descrescător</option>
            <option value="newest" {{ sort == 'newest' ? 'selected' }}>Cele mai noi</option>
        </select>
    </div>
    <div class="col-auto">
        <label for="minPrice" class="form-label small mb-0">Preț minim</label>
        <input type="number" name="minPrice" id="minPrice" value="{{ minPrice }}" min="0" step="0.01" class="form-control form-control-sm" style="width: 7rem">
    </div>
    <div class="col-auto">
        <label for="maxPrice" class="form-label small mb-0">Preț maxim</label>
        <input type="number" name="maxPrice" id="maxPrice" value="{{ maxPrice }}" min="0" step="0.01" class="form-control form-control-sm" style="width: 7rem">
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary btn-sm">Filtrează</button>
    </div>
</form>
