{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} — {{ store.name }}{% endblock %}
{% block meta_description %}{{ category.description|default(store.defaultMetaDescription) }}{% endblock %}

{% block body %}
    <nav class="mb-3" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Acasă</a></li>
            {% for ancestor in category.ancestryChain %}
                {% if loop.last %}
                    <li class="breadcrumb-item active" aria-current="page">{{ ancestor.name }}</li>
                {% else %}
                    <li class="breadcrumb-item"><a href="{{ path('app_category_show', { slug: ancestor.slug }) }}">{{ ancestor.name }}</a></li>
                {% endif %}
            {% endfor %}
        </ol>
    </nav>

    <h1>{{ category.name }}</h1>
    {% if category.description %}
        <p>{{ category.description }}</p>
    {% endif %}

    {% if category.children is not empty %}
        <div class="d-flex flex-wrap gap-2 mb-4">
            {% for child in category.children %}
                <a href="{{ path('app_category_show', { slug: child.slug }) }}" class="btn btn-outline-secondary btn-sm">{{ child.name }}</a>
            {% endfor %}
        </div>
    {% endif %}

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-4">
        {% for product in products %}
            {% include 'product/_card.html.twig' %}
        {% else %}
            <p>Nu există produse în această categorie.</p>
        {% endfor %}
    </div>

    {% if totalPages > 1 %}
        <nav aria-label="Paginare">
            <ul class="pagination">
                {% for p in 1..totalPages %}
                    <li class="page-item {{ p == page ? 'active' }}">
                        <a class="page-link" href="{{ path('app_category_show', { slug: category.slug, page: p }) }}">{{ p }}</a>
                    </li>
                {% endfor %}
            </ul>
        </nav>
    {% endif %}
{% endblock %}
