{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} — {{ store.name }}{% endblock %}
{% block meta_description %}{{ category.description|default(store.defaultMetaDescription) }}{% endblock %}

{% block body %}
    <nav class="breadcrumb">
        <a href="{{ path('app_home') }}">Acasă</a> &gt; {{ category.name }}
    </nav>

    <h1>{{ category.name }}</h1>
    {% if category.description %}
        <p>{{ category.description }}</p>
    {% endif %}

    <div class="product-grid">
        {% for product in products %}
            {% include 'product/_card.html.twig' %}
        {% else %}
            <p>Nu există produse în această categorie.</p>
        {% endfor %}
    </div>

    {% if totalPages > 1 %}
        <nav class="pagination">
            {% for p in 1..totalPages %}
                {% if p == page %}
                    <span class="pagination__current">{{ p }}</span>
                {% else %}
                    <a href="{{ path('app_category_show', { slug: category.slug, page: p }) }}">{{ p }}</a>
                {% endif %}
            {% endfor %}
        </nav>
    {% endif %}
{% endblock %}
