{% extends 'base.html.twig' %}

{% block title %}{{ product.metaTitle|default(product.name) }} — {{ store.name }}{% endblock %}
{% block meta_description %}{{ product.metaDescription|default(store.defaultMetaDescription) }}{% endblock %}

{% set productImageUrl = product.images is not empty ? absolute_url(asset('images/products/' ~ product.images.first.filename)) : (store.logoPath ? absolute_url(store.logoPath) : null) %}

{% block open_graph %}
    <meta property="og:type" content="product">
    <meta property="og:site_name" content="{{ store.name }}">
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:description" content="{{ block('meta_description') }}">
    <meta property="og:url" content="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">
    {% if productImageUrl %}
        <meta property="og:image" content="{{ productImageUrl }}">
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Product",
            "name": {{ product.name|json_encode|raw }},
            "description": {{ (product.metaDescription|default(product.description))|json_encode|raw }},
            "brand": {
                "@type": "Brand",
                "name": {{ store.name|json_encode|raw }}
            }
            {% if productImageUrl %},"image": {{ productImageUrl|json_encode|raw }}{% endif %},
            "offers": {
                "@type": "Offer",
                "url": {{ (app.request.schemeAndHttpHost ~ app.request.pathInfo)|json_encode|raw }},
                "priceCurrency": "RON",
                "price": {{ product.price|json_encode|raw }},
                "availability": "https://schema.org/{{ product.stockStatus.value == 'in_stock' ? 'InStock' : 'PreOrder' }}"
            }
            {% if averageRating %},"aggregateRating": {
                "@type": "AggregateRating",
                "ratingValue": {{ averageRating|json_encode|raw }},
                "reviewCount": {{ reviews|length }}
            }{% endif %}
        }
    </script>
{% endblock %}

{% block body %}
    <nav class="mb-3" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Acasă</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_category_show', { slug: product.category.slug }) }}">{{ product.category.name }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ product.name }}</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="{% if product.isCurrentlyPromoted %}product-media--promoted{% endif %}">
                {% for image in product.images %}
                    <img src="{{ asset('images/products/' ~ image.filename) }}" alt="{{ product.name }}" class="img-fluid rounded">
                {% else %}
                    <div class="bg-body-tertiary rounded d-flex align-items-center justify-content-center text-body-secondary" style="aspect-ratio: 1; min-height: 240px">Fără imagine</div>
                {% endfor %}
            </div>
        </div>

        <div class="col-md-6">
            {% if product.isCurrentlyPromoted %}
                <span class="badge promoted-badge mb-2">★ Produs promovat</span>
            {% endif %}
            <h1>{{ product.name }}</h1>
            {% include 'product/_stock_badge.html.twig' %}
            <p class="mt-2 mb-0">
                {% if averageRating %}
                    ★ {{ averageRating|number_format(1) }} <span class="text-body-secondary">({{ reviews|length }} recenzi{{ reviews|length == 1 ? 'e' : 'i' }})</span>
                {% else %}
                    <span class="text-body-secondary">Fără recenzii încă</span>
                {% endif %}
            </p>
            <p class="fs-3 fw-bold mt-3" style="color: var(--color-accent-strong)">{{ product.price }} lei</p>

            {% if is_granted('ROLE_WHOLESALE') and product.wholesaleTiers is not empty %}
                <table class="table table-sm w-auto">
                    <caption class="caption-top px-0">Preț pe cantitate</caption>
                    <thead>
                        <tr>
                            <th>Cantitate</th>
                            <th>Preț/buc</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for tier in product.wholesaleTiers %}
                            <tr>
                                <td>{{ tier.minQuantity }}+ buc</td>
                                <td>{{ tier.unitPrice }} lei</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}

            <p class="text-body-secondary">Origine: {{ product.origin }}</p>
            <p>{{ product.description }}</p>

            {% if stockNotificationForm %}
                <div class="mt-4">
                    <p class="text-body-secondary mb-2">Produsul e epuizat momentan. Lasă-ți emailul și te anunțăm imediat ce revine în stoc.</p>
                    {{ form_start(stockNotificationForm, { action: path('app_product_notify_stock', { slug: product.slug }) }) }}
                        <div class="d-flex gap-2">
                            {{ form_widget(stockNotificationForm.email) }}
                            <button type="submit" class="btn btn-primary text-nowrap">Anunță-mă</button>
                        </div>
                    {{ form_end(stockNotificationForm) }}
                </div>
            {% else %}
                <form method="post" action="{{ path('app_cart_add', { product: product.id }) }}" class="add-to-cart-form d-flex align-items-end gap-2 mt-4">
                    <div>
                        <label for="quantity" class="form-label">Cantitate</label>
                        <input type="number" id="quantity" name="quantity" value="1" min="1" {% if product.stockStatus.value == 'in_stock' %}max="{{ product.stock }}"{% endif %} class="form-control" style="width: 6rem">
                    </div>
                    <input type="hidden" name="_token" value="{{ csrf_token('cart_action') }}">
                    <button type="submit" class="btn btn-primary">Adaugă în coș</button>
                </form>
            {% endif %}
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-8">
            <h2 class="h4">Recenzii</h2>

            {% if reviews is empty %}
                <p class="text-body-secondary">Nu există încă recenzii aprobate pentru acest produs.</p>
            {% else %}
                {% for review in reviews %}
                    <div class="border-bottom pb-3 mb-3">
                        <p class="mb-1">
                            {% for i in 1..review.rating %}★{% endfor %}{% if review.rating < 5 %}{% for i in 1..(5 - review.rating) %}☆{% endfor %}{% endif %}
                            <strong>{{ review.user.firstName }}</strong>
                        </p>
                        <p class="mb-0">{{ review.comment }}</p>
                    </div>
                {% endfor %}
            {% endif %}

            <h3 class="h5 mt-4">Lasă o recenzie</h3>
            {% if not is_granted('ROLE_USER') %}
                <p><a href="{{ path('app_login') }}">Autentifică-te</a> pentru a lăsa o recenzie.</p>
            {% elseif hasReviewed %}
                <p class="text-body-secondary">Ai lăsat deja o recenzie pentru acest produs.</p>
            {% else %}
                {{ form_start(reviewForm, { action: path('app_review_create', { slug: product.slug }) }) }}
                    {{ form_row(reviewForm.rating) }}
                    {{ form_row(reviewForm.comment) }}
                    <button type="submit" class="btn btn-primary">Trimite recenzia</button>
                {{ form_end(reviewForm) }}
            {% endif %}
        </div>
    </div>
{% endblock %}
