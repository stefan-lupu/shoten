{% extends 'base.html.twig' %}

{% block title %}{{ product.metaTitle|default(product.name) }} — {{ store.name }}{% endblock %}
{% block meta_description %}{{ product.metaDescription|default(store.defaultMetaDescription) }}{% endblock %}

{% block body %}
    <nav class="mb-3" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Acasă</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_category_show', { slug: product.category.slug }) }}">{{ product.category.name }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ product.name }}</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-md-6">
            {% for image in product.images %}
                <img src="{{ asset('images/products/' ~ image.filename) }}" alt="{{ product.name }}" class="img-fluid rounded">
            {% else %}
                <div class="bg-body-tertiary rounded d-flex align-items-center justify-content-center text-body-secondary" style="aspect-ratio: 1; min-height: 240px">Fără imagine</div>
            {% endfor %}
        </div>

        <div class="col-md-6">
            <h1>{{ product.name }}</h1>
            {% include 'product/_stock_badge.html.twig' %}
            <p class="fs-4 fw-bold mt-3">{{ product.price }} lei</p>
            <p class="text-body-secondary">Origine: {{ product.origin }}</p>
            <p>{{ product.description }}</p>

            <form method="post" action="{{ path('app_cart_add', { product: product.id }) }}" class="add-to-cart-form d-flex align-items-end gap-2 mt-4">
                <div>
                    <label for="quantity" class="form-label">Cantitate</label>
                    <input type="number" id="quantity" name="quantity" value="1" min="1" {% if product.stockStatus.value == 'in_stock' %}max="{{ product.stock }}"{% endif %} class="form-control" style="width: 6rem">
                </div>
                <input type="hidden" name="_token" value="{{ csrf_token('cart_action') }}">
                <button type="submit" class="btn btn-primary">Adaugă în coș</button>
            </form>
        </div>
    </div>
{% endblock %}
