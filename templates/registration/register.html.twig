{% extends 'base.html.twig' %}

{% block title %}Cont nou — {{ store.name }}{% endblock %}

{% block body %}
    <h1>Cont nou</h1>

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm) }}
        {{ form_row(registrationForm.email, { label: 'Email' }) }}
        {{ form_row(registrationForm.firstName, { label: 'Prenume' }) }}
        {{ form_row(registrationForm.lastName, { label: 'Nume' }) }}
        {{ form_row(registrationForm.phone, { label: 'Telefon (opțional)' }) }}
        {{ form_row(registrationForm.plainPassword, {
            label: 'Parolă'
        }) }}
        {{ form_row(registrationForm.agreeTerms, { label: 'Sunt de acord cu termenii și condițiile' }) }}

        <button type="submit" class="btn">Creează cont</button>
    {{ form_end(registrationForm) }}
{% endblock %}
